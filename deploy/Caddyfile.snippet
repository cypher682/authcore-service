# Append this block to /opt/caddy/Caddyfile, then reload Caddy.
# The hostname is generated by sslip.io: <subdomain>.<ip-with-dashes>.sslip.io -> 141.148.69.94.
# No DNS record is needed. Caddy issues the certificate on the first request.

authcore.141-148-69-94.sslip.io {
	encode zstd gzip
	reverse_proxy authcore-app:8000
}
