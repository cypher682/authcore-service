# Template for /opt/apps/authcore/.env on the server. Never commit the real file.
#
#   install -m 600 deploy/.env.prod.example /opt/apps/authcore/.env   # then fill the blanks
#   openssl rand -hex 32   -> APP_SECRET_KEY
#   openssl rand -hex 24   -> POSTGRES_PASSWORD
#
# docs/deployment/vps-caddy.md has a copy-paste heredoc that writes the required subset directly.
#
# Keep both values hex-only: POSTGRES_PASSWORD is interpolated into the DATABASE_URL,
# so characters like @ : / would break the connection string.

APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=

# Consumed by the postgres service and composed into DATABASE_URL by the compose file.
POSTGRES_USER=authcore
POSTGRES_PASSWORD=
POSTGRES_DB=authcore_db

# The app container runs "alembic upgrade head" before uvicorn starts.
RUN_MIGRATIONS_ON_START=true

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_CHALLENGE_EXPIRE_MINUTES=5
JWT_ALGORITHM=HS256

# Rate limiting (per client IP; Caddy forwards X-Forwarded-For)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SENSITIVE=5/minute

# Sessions and lockout
MAX_CONCURRENT_SESSIONS=5
SESSION_EXPIRE_DAYS=30
MAX_FAILED_ATTEMPTS=5
LOCKOUT_TTL_SECONDS=900

# Email — the Celery tasks are still stubs, so leave these blank until SMTP is wired.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@authcore.example

# Optional
SENTRY_DSN=
HIBP_API_KEY=
PASSWORD_BREACH_CHECK_ENABLED=false
PASSWORD_BREACH_CHECK_FAIL_CLOSED=false
HIBP_TIMEOUT_SECONDS=2.0
